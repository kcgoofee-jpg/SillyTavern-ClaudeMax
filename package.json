{
  "name": "sillytavern-claude-max",
  "version": "3.0.1",
  "description": "OpenAI-compatible proxy backed by the Claude Agent SDK so chat bills against your Anthropic Pro/Max subscription. Runs standalone (TauriTavern / any frontend) or as a SillyTavern server plugin.",
  "main": "src/proxy/plugin.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "login": "node bin/claude-cli.js auth login",
    "auth": "node bin/claude-cli.js auth status",
    "test": "node --test",
    "test:py": "python3 -m unittest discover -s test/launcher -p 'test_*.py'",
    "version": "node scripts/version.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "express": "^4.21.0"
  },
  "bin": {
    "claude-subscription-proxy": "server.js"
  }
}
